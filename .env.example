# Code Agent 配置文件
# 复制此文件为 .env 并填入你的 API 密钥

# ============ 必需配置 ============

# OpenAI API 密钥（必需）
# 获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API 基础 URL（可选，用于代理或自定义端点）
# 如果使用官方 API 可以不设置，使用代理时填写代理地址
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============ 可选配置 ============

# Tavily API 密钥（用于网络搜索功能）
# 获取地址：https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI 模型（默认：gpt-4.1）
# 可选：gpt-4.1, gpt-4.1-mini, gpt-4o 等
# CODE_AGENT_MODEL=gpt-4.1

# 响应最大 token 数（默认：4096）
# CODE_AGENT_MAX_TOKENS=4096

# Agent 最大迭代次数（默认：50）
# CODE_AGENT_MAX_ITERATIONS=50

# 工作目录（默认：当前目录）
# CODE_AGENT_WORKING_DIR=/path/to/your/project

# 启用详细输出（默认：false）
# CODE_AGENT_VERBOSE=true

# 日志级别（默认：INFO）
# 可选：DEBUG, INFO, WARNING, ERROR, CRITICAL
# CODE_AGENT_LOG_LEVEL=INFO

# 日志文件路径（可选，默认输出到 stderr）
# CODE_AGENT_LOG_FILE=/path/to/agent.log
