# Code Agent 配置文件
# 复制此文件为 .env 并填入你的 API 密钥

# ============ 必需配置 ============

# Anthropic API 密钥（必需）
# 获取地址：https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic API 基础 URL（可选，用于代理或自定义端点）
# 如果使用官方 API 可以不设置，使用代理时填写代理地址
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============ 可选配置 ============

# Tavily API 密钥（用于网络搜索功能）
# 获取地址：https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Claude 模型（默认：claude-sonnet-4-20250514）
# 可选：claude-sonnet-4-20250514, claude-opus-4-5-20251101 等
# CODE_AGENT_MODEL=claude-sonnet-4-20250514

# 响应最大 token 数（默认：4096）
# CODE_AGENT_MAX_TOKENS=4096

# Agent 最大迭代次数（默认：50）
# CODE_AGENT_MAX_ITERATIONS=50

# 工作目录（默认：当前目录）
# CODE_AGENT_WORKING_DIR=/path/to/your/project

# 启用详细输出（默认：false）
# CODE_AGENT_VERBOSE=true
